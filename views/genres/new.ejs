<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo género | MovieStream</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <nav class="navbar">
      <a href="/genres">Volver a géneros</a>
      <a href="/">Inicio</a>
    </nav>

    <h1>Nuevo género</h1>

    <form class="form" method="POST" action="/genres">
      <label>Nombre</label>
      <input name="name" required>

      <label>Descripción</label>
      <textarea name="description" required></textarea>

      <button type="submit">Guardar género</button>
    </form>
  </main>
</body>
</html>