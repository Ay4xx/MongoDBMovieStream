<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar género | MovieStream</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <nav class="navbar">
      <a href="/genres">Volver a géneros</a>
      <a href="/">Inicio</a>
    </nav>

    <h1>Editar género</h1>

    <form class="form" method="POST" action="/genres/<%= genre._id %>?_method=PUT">
      <label>Nombre</label>
      <input name="name" value="<%= genre.name %>" required>

      <label>Descripción</label>
      <textarea name="description" required><%= genre.description %></textarea>

      <button type="submit">Actualizar género</button>
    </form>
  </main>
</body>
</html>