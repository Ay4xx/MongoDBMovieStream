<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Géneros | MovieStream</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <nav class="navbar">
      <a href="/">Inicio</a>
      <a href="/movies">Películas</a>
      <a href="/genres/new">Nuevo género</a>
    </nav>

    <h1>Géneros</h1>

    <form class="search-form" method="GET" action="/genres">
      <input 
        type="text" 
        name="search" 
        placeholder="Buscar género"
        value="<%= search %>"
      >
      <button type="submit">Buscar</button>
    </form>

    <div class="grid">
      <% genres.forEach(genre => { %>
        <article class="card">
          <h2><%= genre.name %></h2>
          <p><%= genre.description %></p>

          <div class="card-actions">
            <a class="button small" href="/genres/<%= genre._id %>/edit">Editar</a>

            <form method="POST" action="/genres/<%= genre._id %>?_method=DELETE">
              <button class="danger small" type="submit">Eliminar</button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  </main>
</body>
</html>