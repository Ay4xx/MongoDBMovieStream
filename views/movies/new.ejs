<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nueva película | MovieStream</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <nav class="navbar">
      <a href="/movies">Volver a películas</a>
      <a href="/">Inicio</a>
    </nav>

    <h1>Nueva película</h1>

    <form class="form" method="POST" action="/movies">
      <label>Título</label>
      <input name="title" required>

      <label>Año</label>
      <input name="year" type="number" required>

      <label>Duración en minutos</label>
      <input name="durationMinutes" type="number" required>

      <label>Descripción</label>
      <textarea name="description" required></textarea>

      <label>Rating promedio</label>
      <input name="ratingAverage" type="number" step="0.1" min="0" max="5" required>

      <label>Géneros</label>
      <div class="checkbox-group">
        <% genres.forEach(genre => { %>
          <label class="checkbox">
            <input type="checkbox" name="genres" value="<%= genre._id %>">
            <%= genre.name %>
          </label>
        <% }) %>
      </div>

      <label>Actor 1</label>
      <select name="actor1">
        <option value="">Selecciona un actor</option>
        <% actors.forEach(actor => { %>
          <option value="<%= actor._id %>"><%= actor.name %></option>
        <% }) %>
      </select>

      <label>Rol actor 1</label>
      <input name="role1">

      <label>Actor 2</label>
      <select name="actor2">
        <option value="">Selecciona un actor</option>
        <% actors.forEach(actor => { %>
          <option value="<%= actor._id %>"><%= actor.name %></option>
        <% }) %>
      </select>

      <label>Rol actor 2</label>
      <input name="role2">

      <button type="submit">Guardar película</button>
    </form>
  </main>
</body>
</html>